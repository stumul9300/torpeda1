# Скопируйте этот файл в .env (в той же папке backend) и вставьте свои ключи.
# Файл .env остаётся только на вашем компьютере и в репозиторий не попадает.

# Ключ «только чтение»: Контент, Цены и скидки, Статистика, Аналитика, Тарифы, Продвижение
WB_API_TOKEN=

# Ключ «чтение и запись» только с категорией «Цены и скидки» — для отправки цен
WB_PRICES_TOKEN=

# Токен API MPSTATS (mpstats.io/userpanel, блок «API токен») — для python -m torpeda.mpstats
MPSTATS_TOKEN=
